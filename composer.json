{
    "name": "nitsan/ns-t3al",
    "type": "typo3-cms-extension",
    "description": "AI-Powered XLIFF Translation - Translate TYPO3 extension XLIFF files with AI and publish them to Crowdin from the TYPO3 backend.",
    "homepage": "https://t3planet.de/t3al-typo3-erweiterung",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Team T3Planet",
            "role": "Developer",
            "homepage": "https://t3planet.de",
            "email": "support@t3planet.de"
        }
    ],
    "keywords": [
        "TYPO3",
        "AI Localization",
        "localization",
        "crowdin"
    ],
    "support": {
        "issues": "https://t3planet.de/support"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "typo3/cms-core": "^12.4.18 || ^13.4 || ^14.3",
        "typo3/cms-backend": "^12.4.18 || ^13.4 || ^14.3",
        "typo3/cms-extbase": "^12.4.18 || ^13.4 || ^14.3",
        "typo3/cms-extensionmanager": "^12.4.18 || ^13.4 || ^14.3",
        "typo3/cms-fluid": "^12.4.18 || ^13.4 || ^14.3",
        "nitsan/ns-license": "^14.5.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.2 || ^12.1",
        "typo3/testing-framework": "^8.2 || ^9.0"
    },
    "autoload": {
        "psr-4": {
            "NITSAN\\NsT3AL\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NITSAN\\NsT3AL\\Tests\\": "Tests"
        }
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "scripts": {
        "cs:check": ".Build/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": ".Build/bin/php-cs-fixer fix",
        "stan": ".Build/bin/phpstan analyse --memory-limit=512M",
        "test": ".Build/bin/phpunit -c Build/phpunit/UnitTests.xml",
        "ci": [
            "@composer test",
            "@composer stan",
            "@composer cs:check"
        ]
    },
    "scripts-descriptions": {
        "cs:check": "Run PHP-CS-Fixer in dry-run mode (.php-cs-fixer.php)",
        "cs:fix": "Apply PHP-CS-Fixer fixes",
        "stan": "Run PHPStan static analysis (phpstan.neon)",
        "test": "Run unit tests (Build/phpunit/UnitTests.xml)",
        "ci": "Run what the GitLab pipeline runs: unit tests, PHPStan, coding standards"
    },
    "extra": {
        "typo3/cms": {
            "web-dir": ".Build/public",
            "extension-key": "ns_t3al",
            "version": "1.0.0"
        }
    }
}
